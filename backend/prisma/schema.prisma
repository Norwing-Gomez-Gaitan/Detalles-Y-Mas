datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas  = ["manualidades"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

enum EstadoPedido {
  cotizacion
  confirmado
  en_produccion
  listo
  entregado
  cancelado

  @@map("estado_pedido")
  @@schema("manualidades")
}

enum TipoEntrega {
  retiro_local
  domicilio
  envio

  @@map("tipo_entrega")
  @@schema("manualidades")
}

enum MetodoPago {
  efectivo
  transferencia
  tarjeta
  billetera_movil
  otro

  @@map("metodo_pago")
  @@schema("manualidades")
}

enum TipoMovimiento {
  compra
  consumo_produccion
  ajuste
  merma
  devolucion

  @@map("tipo_movimiento")
  @@schema("manualidades")
}

enum TipoGasto {
  transporte
  empaque
  publicidad
  servicios
  herramientas
  otro

  @@map("tipo_gasto")
  @@schema("manualidades")
}

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(80)
  descripcion String?
  activa      Boolean    @default(true)
  productos   Producto[]

  @@map("categorias")
  @@schema("manualidades")
}

model Producto {
  id                   Int                 @id @default(autoincrement())
  categoria_id         Int
  codigo               String              @unique @db.VarChar(30)
  slug                 String              @unique @db.VarChar(150)
  nombre               String              @db.VarChar(120)
  descripcion          String?
  precio_venta         Decimal             @db.Decimal(12, 2)
  tiempo_elaboracion_min Int?
  es_personalizable    Boolean             @default(false)
  stock_terminado      Int                 @default(0)
  imagen_url           String?
  visible_catalogo     Boolean             @default(true)
  destacado            Boolean             @default(false)
  activo               Boolean             @default(true)
  creado_en            DateTime            @default(now()) @db.Timestamptz(6)
  actualizado_en       DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  categoria            Categoria           @relation(fields: [categoria_id], references: [id], onDelete: Restrict)
  imagenes             ProductoImagen[]
  materiales           ProductoMaterial[]
  detalles_pedido      DetallePedido[]

  @@index([categoria_id], map: "idx_productos_categoria")
  @@index([slug], map: "idx_productos_slug")
  @@map("productos")
  @@schema("manualidades")
}

model ProductoImagen {
  id          Int      @id @default(autoincrement())
  producto_id Int
  url         String
  orden       Int      @default(0)

  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@index([producto_id, orden], map: "idx_producto_imagenes_prod")
  @@map("producto_imagenes")
  @@schema("manualidades")
}

model Proveedor {
  id         Int          @id @default(autoincrement())
  nombre     String       @db.VarChar(120)
  contacto   String?      @db.VarChar(100)
  telefono   String?      @db.VarChar(30)
  email      String?      @db.VarChar(120)
  direccion  String?
  notas      String?
  activo     Boolean      @default(true)
  materiales Material[]
  compras    Compra[]

  @@map("proveedores")
  @@schema("manualidades")
}

model Material {
  id             Int                    @id @default(autoincrement())
  nombre         String                 @unique @db.VarChar(120)
  unidad_medida  String                 @db.VarChar(20)
  stock_actual   Decimal                @default(0) @db.Decimal(12, 2)
  stock_minimo   Decimal                @default(0) @db.Decimal(12, 2)
  costo_unitario Decimal                @default(0) @db.Decimal(12, 4)
  proveedor_id   Int?
  activo         Boolean                @default(true)

  proveedor      Proveedor?             @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  productos      ProductoMaterial[]
  detalles_compra DetalleCompra[]
  movimientos    MovimientoInventario[]

  @@map("materiales")
  @@schema("manualidades")
}

model ProductoMaterial {
  producto_id Int
  material_id Int
  cantidad    Decimal  @db.Decimal(12, 3)

  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  material    Material @relation(fields: [material_id], references: [id], onDelete: Restrict)

  @@id([producto_id, material_id])
  @@map("producto_materiales")
  @@schema("manualidades")
}

model Compra {
  id             Int             @id @default(autoincrement())
  proveedor_id   Int?
  fecha          DateTime        @default(now()) @db.Date
  numero_factura String?         @db.VarChar(50)
  total          Decimal         @default(0) @db.Decimal(12, 2)
  notas          String?

  proveedor      Proveedor?      @relation(fields: [proveedor_id], references: [id], onDelete: SetNull)
  detalles       DetalleCompra[]

  @@map("compras")
  @@schema("manualidades")
}

model DetalleCompra {
  id             Int      @id @default(autoincrement())
  compra_id      Int
  material_id    Int
  cantidad       Decimal  @db.Decimal(12, 3)
  costo_unitario Decimal  @db.Decimal(12, 4)
  subtotal       Decimal? @db.Decimal(12, 2)

  compra         Compra   @relation(fields: [compra_id], references: [id], onDelete: Cascade)
  material       Material @relation(fields: [material_id], references: [id], onDelete: Restrict)

  @@index([compra_id], map: "idx_det_compras_compra")
  @@map("detalle_compras")
  @@schema("manualidades")
}

model MovimientoInventario {
  id          BigInt          @id @default(autoincrement())
  material_id Int
  tipo        TipoMovimiento
  cantidad    Decimal         @db.Decimal(12, 3)
  referencia  String?         @db.VarChar(60)
  fecha       DateTime        @default(now()) @db.Timestamptz(6)
  notas       String?

  material    Material        @relation(fields: [material_id], references: [id], onDelete: Restrict)

  @@index([material_id, fecha(sort: Desc)], map: "idx_mov_material")
  @@map("movimientos_inventario")
  @@schema("manualidades")
}

model Cliente {
  id             Int       @id @default(autoincrement())
  nombre         String    @db.VarChar(120)
  telefono       String?   @db.VarChar(30)
  whatsapp       String?   @db.VarChar(30)
  email          String?   @db.VarChar(120)
  direccion      String?
  red_social     String?   @db.VarChar(100)
  fecha_especial DateTime? @db.Date
  notas          String?
  creado_en      DateTime  @default(now()) @db.Timestamptz(6)

  pedidos        Pedido[]

  @@index([nombre], map: "idx_clientes_nombre")
  @@map("clientes")
  @@schema("manualidades")
}

model Pedido {
  id                Int             @id @default(autoincrement())
  cliente_id        Int
  fecha_pedido      DateTime        @default(now()) @db.Timestamptz(6)
  fecha_entrega     DateTime?       @db.Timestamptz(6)
  estado            EstadoPedido    @default(cotizacion)
  tipo_entrega      TipoEntrega     @default(retiro_local)
  direccion_entrega String?
  costo_envio       Decimal         @default(0) @db.Decimal(12, 2)
  descuento         Decimal         @default(0) @db.Decimal(12, 2)
  total             Decimal         @default(0) @db.Decimal(12, 2)
  notas             String?
  actualizado_en    DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  cliente           Cliente         @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  detalles          DetallePedido[]
  pagos             Pago[]
  gastos            Gasto[]

  @@index([cliente_id], map: "idx_pedidos_cliente")
  @@index([estado, fecha_entrega], map: "idx_pedidos_estado_entrega")
  @@map("pedidos")
  @@schema("manualidades")
}

model DetallePedido {
  id                    Int       @id @default(autoincrement())
  pedido_id             Int
  producto_id           Int?
  descripcion           String    @db.VarChar(200)
  cantidad              Int
  precio_unitario       Decimal   @db.Decimal(12, 2)
  costo_estimado        Decimal   @default(0) @db.Decimal(12, 2)
  personalizacion       String?
  imagen_referencia_url String?
  subtotal              Decimal?  @db.Decimal(12, 2)

  pedido                Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto              Producto? @relation(fields: [producto_id], references: [id], onDelete: SetNull)

  @@index([pedido_id], map: "idx_det_pedido_pedido")
  @@map("detalle_pedido")
  @@schema("manualidades")
}

model Pago {
  id          Int        @id @default(autoincrement())
  pedido_id   Int
  fecha       DateTime   @default(now()) @db.Timestamptz(6)
  monto       Decimal    @db.Decimal(12, 2)
  metodo      MetodoPago @default(efectivo)
  es_anticipo Boolean    @default(false)
  referencia  String?    @db.VarChar(80)
  notas       String?

  pedido      Pedido     @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@index([pedido_id], map: "idx_pagos_pedido")
  @@map("pagos")
  @@schema("manualidades")
}

model Gasto {
  id          Int       @id @default(autoincrement())
  fecha       DateTime  @default(now()) @db.Date
  tipo        TipoGasto @default(otro)
  descripcion String    @db.VarChar(200)
  monto       Decimal   @db.Decimal(12, 2)
  pedido_id   Int?

  pedido      Pedido?   @relation(fields: [pedido_id], references: [id], onDelete: SetNull)

  @@index([fecha], map: "idx_gastos_fecha")
  @@map("gastos")
  @@schema("manualidades")
}

model UsuarioAdmin {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(120)
  email         String   @unique @db.VarChar(120)
  password_hash String   @db.VarChar(255)
  activo        Boolean  @default(true)
  creado_en     DateTime @default(now()) @db.Timestamptz(6)

  @@map("usuarios_admin")
  @@schema("manualidades")
}

model ConfiguracionNegocio {
  id                  Int      @id @default(autoincrement())
  nombre              String   @default("Detalles y Más") @db.VarChar(120)
  lema                String   @default("Hecho con amor para cada ocasión") @db.VarChar(200)
  telefono            String?  @default("8485-6722") @db.VarChar(30)
  whatsapp            String?  @default("8485-6722") @db.VarChar(30)
  instagram           String?  @default("@detallesymas.ni") @db.VarChar(100)
  facebook            String?  @default("https://www.facebook.com/Aracelly82") @db.VarChar(100)
  direccion_cobertura String?  @default("Managua, Nicaragua. Envíos a todo el país.")
  horario             String?  @default("Lunes a Sábado: 8:00 AM - 6:00 PM")
  sobre_nosotros      String?  @default("Somos un taller de manualidades y detalles personalizados en Nicaragua.")
  actualizado_en      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("configuracion_negocio")
  @@schema("manualidades")
}

