# ==============================================================
# VARIABLES DE ENTORNO - BACKEND (RENDER / LOCAL)
# ==============================================================

PORT=5000
NODE_ENV=development

# Base de datos PostgreSQL (Supabase o Docker Local)
# Para Supabase:
# DATABASE_URL: Pooler de Supabase (puerto 6543 con ?pgbouncer=true&connection_limit=1)
# DIRECT_URL: Conexión directa (puerto 5432)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/manualidades?schema=manualidades"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/manualidades?schema=manualidades"

# Seguridad y Autenticación JWT
JWT_SECRET="clave_secreta_super_segura_para_detalles_y_mas_jwt_2026"
JWT_EXPIRES_IN="7d"

# Origen permitido para CORS (URL de Vercel en producción o localhost en dev)
FRONTEND_URL="http://localhost:3000"

# Supabase Storage para fotos de productos
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu_supabase_service_role_key"
SUPABASE_BUCKET="productos"

# Envío de Correos (SMTP / Gmail App Password)
# Para Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER="tu-correo@gmail.com", SMTP_PASS="tu_app_password"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM='"Detalles y Más" <seguridad@detallesymas.ni>'

